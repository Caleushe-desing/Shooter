[Unit]
Description=Check list Técnico (API + SPA)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/checklist/server
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=COOKIE_SECURE=1
EnvironmentFile=-/opt/checklist/server/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
